<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="recipes.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1110"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="recipes" custom_title="0" dock_id="1" table="4,7:mainrecipes"/><dock_state state="000000ff00000000fd0000000100000002000005f2000002c7fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f20000014700ffffff000002e40000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="favorites" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="111"/><column index="2" value="92"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="recipes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="32"/><column index="2" value="140"/><column index="3" value="88"/><column index="4" value="300"/><column index="5" value="300"/><column index="6" value="96"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="45"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO recipes (title, category, ingredients, steps, author_id) VALUES
('Французские тосты', 'Завтраки', 'Хлеб тостовый - 4 куска, Яйцо - 2 шт, Молоко - 50 мл, Корица - 0.5 ч.л., Сливочное масло - 20 г', '1. Взбейте яйца с молоком и корицей. 2. Обмакните хлеб в смесь. 3. Обжарьте на сливочном масле с двух сторон.', NULL),
('Овсянка с бананом', 'Завтраки', 'Овсяные хлопья - 50 г, Молоко - 200 мл, Банан - 1 шт, Мед - 1 ч.л.', '1. Сварите овсянку на молоке. 2. Нарежьте банан кружочками. 3. Выложите банан на кашу, полейте медом.', NULL),
('Скрембл со шпинатом', 'Завтраки', 'Яйца - 3 шт, Шпинат - 30 г, Сливочное масло - 15 г, Соль, перец', '1. Обжарьте шпинат на масле 1 минуту. 2. Взбейте яйца, вылейте на сковороду. 3. Постоянно помешивайте на слабом огне.', NULL),
('Панкейки классические', 'Завтраки', 'Мука - 150 г, Молоко - 200 мл, Яйцо - 1 шт, Сахар - 2 ст.л., Разрыхлитель - 1 ч.л.', '1. Смешайте сухие ингредиенты. 2. Добавьте яйцо и молоко, размешайте. 3. Выпекайте на сухой сковороде.', NULL),
('Гренки с чесноком', 'Завтраки', 'Хлеб ржаной - 5 кусков, Чеснок - 2 зубчика, Растительное масло - 2 ст.л., Соль', '1. Нарежьте хлеб брусочками. 2. Обжарьте на масле до корочки. 3. Натрите чесноком и посолите.', NULL),
('Рисовая каша на молоке', 'Завтраки', 'Рис - 100 г, Молоко - 300 мл, Вода - 100 мл, Сахар - 1 ст.л., Сливочное масло', '1. Отварите рис в воде до полуготовности. 2. Добавьте молоко, сахар и варите до мягкости. 3. Добавьте масло.', NULL),
('Творог с ягодами', 'Завтраки', 'Творог - 200 г, Сметана - 2 ст.л., Ягоды замороженные - 50 г, Сахарная пудра', '1. Выложите творог в пиалу. 2. Добавьте сметану. 3. Сверху украсьте ягодами и присыпьте пудрой.', NULL),
('Сэндвич с тунцом', 'Завтраки', 'Тостовый хлеб - 2 куска, Консервированный тунец - 80 г, Майонез - 1 ст.л., Огурец - 30 г', '1. Разминайте тунец с майонезом. 2. Нарежьте огурец слайсами. 3. Выложите все на хлеб и накройте вторым куском.', NULL),
('Яичница в помидоре', 'Завтраки', 'Помидоры крупные - 2 шт, Яйца - 2 шт, Сыр - 30 г, Зелень, соль', '1. Срежьте верхушки помидоров, удалите мякоть. 2. Разбейте внутрь по яйцу, посолите. 3. Посыпьте сыром и запекайте.', NULL),
('Гранола с йогуртом', 'Завтраки', 'Гранола - 50 г, Натуральный йогурт - 150 мл, Киви - 1 шт', '1. Нарежьте киви кубиками. 2. В стакан выложите слоями йогурт, гранолу и киви. 3. Подавайте сразу.', NULL),
('Драники картофельные', 'Завтраки', 'Картофель - 4 шт, Яйцо - 1 шт, Мука - 1 ст.л., Соль, Растительное масло', '1. Натрите картофель на мелкой терке, отожмите сок. 2. Смешайте с яйцом, мукой и солью. 3. Обжарьте оладьями.', NULL),
('Шакшука', 'Завтраки', 'Яйца - 3 шт, Помидоры в соку - 200 г, Болгарский перец - 0.5 шт, Лук - 0.5 шт, Чеснок', '1. Обжарьте лук, чеснок и перец. 2. Добавьте помидоры, тушите 5 минут. 3. Сделайте углубления, разбейте яйца, готовьте под крышкой.', NULL);
</sql><sql name="SQL 2*">INSERT INTO recipes (title, category, ingredients, steps, author_id) VALUES
('Борщ домашний', 'Обеды', 'Говядина - 400 г, Свекла - 1 шт, Капуста - 200 г, Картофель - 3 шт, Морковь - 1 шт, Томатная паста', '1. Сварите бульон из говядины. 2. Обжарьте свеклу, морковь, лук с томатной пастой. 3. Добавьте картофель, капусту и зажарку в бульон.', NULL),
('Суп-пюре из чечевицы', 'Обеды', 'Красная чечевица - 150 г, Лук - 1 шт, Морковь - 1 шт, Лимонный сок - 1 ст.л., Специи', '1. Обжарьте лук и морковь. 2. Добавьте чечевицу и воду, варите 20 минут. 3. Пюрируйте блендером, добавьте лимонный сок.', NULL),
('Куриный суп с лапшой', 'Обеды', 'Куриные окорочка - 1 шт, Лапша - 50 г, Картофель - 2 шт, Лук, Морковь, Зелень', '1. Сварите куриный бульон. 2. Добавьте нарезанный картофель. 3. Сделайте пассеровку из лука и моркови, добавьте в суп вместе с лапшой.', NULL),
('Плов с курицей', 'Обеды', 'Куриное филе - 400 г, Рис - 300 г, Морковь - 2 шт, Лук - 2 шт, Чеснок - 1 головка, Специи для плова', '1. Обжарьте лук, мясо и морковь со специями. 2. Засыпьте рис, залейте водой на 1.5 см выше уровня. 3. Вставьте чеснок, готовьте до впитывания воды.', NULL),
('Грибной крем-суп', 'Обеды', 'Шампиньоны - 300 г, Картофель - 2 шт, Сливки 20% - 150 мл, Лук - 1 шт, Сливочное масло', '1. Обжарьте лук и грибы. 2. Отварите картофель. 3. Соедините все, добавьте сливки, измельчите блендером и прогрейте.', NULL),
('Котлеты по-капитански', 'Обеды', 'Фарш свино-говяжий - 500 г, Лук - 1 шт, Картофель - 2 шт, Сыр - 100 г, Майонез', '1. Сформируйте плоские котлеты, выложите на противень. 2. Сверху положите лук, затем тертый картофель. 3. Смажьте майонезом, посыпьте сыром, запекайте.', NULL),
('Уха классическая', 'Обеды', 'Рыба (лосось/судак) - 400 г, Картофель - 3 шт, Лук - 1 шт, Морковь - 1 шт, Пшено - 2 ст.л., Зелень', '1. Сварите рыбу, достаньте и отделите от костей. 2. В бульон бросьте картофель, морковь, лук и пшено. 3. Верните рыбу, варите до готовности.', NULL),
('Макароны по-флотски', 'Обеды', 'Макароны - 250 г, Фарш мясной - 300 г, Лук - 1 шт, Сливочное масло - 20 г, Соль', '1. Отварите макароны. 2. Обжарьте лук с фаршем до готовности. 3. Смешайте макароны с фаршем и сливочным масле.', NULL),
('Гречка с грибами', 'Обеды', 'Гречневая крупа - 150 г, Шампиньоны - 200 г, Лук - 1 шт, Растительное масло, Соль', '1. Сварите гречку. 2. Обжарьте лук с грибами на сковороде. 3. Смешайте готовую гречку с зажаркой.', NULL),
('Тефтели в томатном соусе', 'Обеды', 'Фарш - 400 г, Рис отварной - 100 г, Лук - 1 шт, Томатная паста - 2 ст.л., Мука - 1 ст.л.', '1. Смешайте фарш, рис и измельченный лук, слепите шарики. 2. Обжарьте тефтели. 3. Залейте соусом из воды, томатной пасты и муки, тушите 20 минут.', NULL),
('Гороховый суп с копченостями', 'Обеды', 'Гороховый суп с копченостями', '1. Замочите горох, сварите вместе с ребрами. 2. Добавьте картофель. 3. Сделайте зажарку из лука и моркови.', NULL),
('Гуляш из говядины', 'Обеды', 'Говядина - 500 г, Лук - 2 шт, Мука - 1 ст.л., Томатная паста - 2 ст.л., Вода - 300 мл', '1. Нарежьте мясо кубиками, обжарьте с луком. 2. Посыпьте мукой, добавьте томатную пасту. 3. Залейте водой и тушите 1.5 часа.', NULL),
('Щи из свежей капусты', 'Обеды', 'Свинина - 300 г, Капуста - 300 г, Картофель - 3 шт, Морковь - 1 шт, Лук - 1 шт, Помидор - 1 шт', '1. Сварите мясной бульон. 2. Добавьте картофель и нашинкованную капусту. 3. Обжарьте лук, морковь и помидор, переложите в суп.', NULL);
</sql><sql name="SQL 3*">INSERT INTO recipes (title, category, ingredients, steps, author_id) VALUES
('Запеченная рыба с лимоном', 'Ужины', 'Филе белой рыбы - 400 г, Лимон - 0.5 шт, Оливковое масло - 1 ст.л., Специи для рыбы', '1. Выложите рыбу на фольгу. 2. Посолите, полейте маслом. 3. Сверху положите кружочки лимона, заверните фольгу и запекайте 20 минут.', NULL),
('Куриные грудки в сливках', 'Ужины', 'Куриное филе - 500 г, Сливки 10% - 200 мл, Чеснок - 2 зубчика, Растительное масло', '1. Нарежьте филе кусочками, обжарьте до корочки. 2. Снизьте огонь, добавьте измельченный чеснок. 3. Залейте сливками, тушите 10 минут.', NULL),
('Овощное рагу', 'Ужины', 'Кабачок - 1 шт, Баклажан - 1 шт, Болгарский перец - 1 шт, Помидоры - 2 шт, Лук, Чеснок', '1. Нарежьте все овощи кубиками. 2. Обжарьте лук с чесноком, добавьте баклажаны и кабачки. 3. Добавьте перец и помидоры, тушите.', NULL),
('Салат Цезарь с курицей', 'Ужины', 'Куриное филе - 150 г, Салат Романо - 100 г, Сухарики - 30 г, Сыр Пармезан - 20 г, Соус Цезарь', '1. Обжарьте куриное филе слайсами. 2. Нарвите салат руками, смешайте с соусом. 3. Сверху выложите курицу, сухарики и пармезан.', NULL),
('Паста Карбонара', 'Ужины', 'Спагетти - 200 г, Бекон - 100 г, Желтки яичные - 3 шт, Пармезан - 50 г, Черный перец', '1. Отварите спагетти. 2. Обжарьте бекон. 3. Смешайте желтки с тертым сыром. Соедините горячую пасту, бекон и соус, быстро перемешайте.', NULL),
('Стейк из свинины', 'Ужины', 'Свиная шея - 2 стейка, Розмарин - 1 веточка, Чеснок - 2 зубчика, Растительное масло', '1. Обсушите мясо, посолите и поперчите. 2. Выложите на раскаленную сковороду с маслом, розмарином и чесноком. 3. Обжаривайте по 5 минут.', NULL),
('Фаршированные перцы', 'Ужины', 'Болгарский перец - 4 шт, Фарш - 300 г, Рис - 50 г, Сметана - 2 ст.л., Томатный соус - 2 ст.л.', '1. Смешайте фарш с полуотварным рисом. 2. Очистите перцы от семян, нафаршируйте. 3. Выложите в кастрюлю, залейте соусом, тушите 40 минут.', NULL),
('Плов с грибами', 'Ужины', 'Рис - 200 г, Шампиньоны - 300 г, Морковь - 1 шт, Лук - 1 шт, Приправа для плова', '1. Обжарьте лук, морковь и грибы. 2. Добавьте рис и специи. 3. Залейте водой и готовьте на медленном огне до впитывания жидкости.', NULL),
('Жаркое в горшочках', 'Ужины', 'Свинина - 300 г, Картофель - 4 шт, Лук - 1 шт, Грибы - 150 г, Сметана - 4 ст.л.', '1. Нарежьте мясо и овощи. 2. Разложите слоями в горшочки: мясо, лук, грибы, картофель. 3. Сверху положите сметану, влейте воду, запекайте.', NULL),
('Куриные крылышки барбекю', 'Ужины', 'Куриные крылья - 500 г, Соус барбекю - 3 ст.л., Мед - 1 ч.л., Чеснок сушеный', '1. Замаринуйте крылья в соусе барбекю, меде и чесноке. 2. Выложите на противень. 3. Запекайте при 200 градусах 30-35 минут.', NULL),
('Салат с греческим сыром', 'Ужины', 'Помидоры - 2 шт, Огурцы - 2 шт, Перец болгарский - 1 шт, Сыр Фета - 100 г, Маслины - 50 г, Оливковое масло', '1. Крупно нарежьте овощи. 2. Добавьте маслины и кубики Феты. 3. Заправьте оливковым маслом и прованскими травами.', NULL),
('Свиные ребра в духовке', 'Ужины', 'Свиные ребра - 600 г, Горчица - 1 ст.л., Кетчуп - 2 ст.л., Соевый соус - 2 ст.л.', '1. Смешайте горчицу, кетчуп и соевый соус, натрите ребра. 2. Заверните в фольгу. 3. Запекайте 1 час, затем откройте фольгу и подрумяньте.', NULL),
('Тёплый салат с курицей', 'Ужины', 'Куриное филе - 200 г, Салатный микс - 80 г, Черри - 6 шт, Стручковая фасоль - 100 г', '1. Отварите фасоль 3 минуты. 2. Обжарьте кусочки курицы. 3. Смешайте зелень, черри, фасоль и теплую курицу, заправьте маслом.', NULL);
</sql><current_tab id="2"/></tab_sql></sqlb_project>
